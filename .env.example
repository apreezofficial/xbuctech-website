# Set this to the ProForms submission endpoint for your account.
# The contact form falls back to https://proforms.top when unset.
NEXT_PUBLIC_PROFORMS_ENDPOINT=https://proforms.top

# Resend mail composer settings. RESEND_FROM_EMAIL must use a verified domain.
RESEND_API_KEY=re_xxxxxxxxx
RESEND_FROM_NAME=XBUC TECH
MAIL_ACCESS_KEY=replace-with-a-long-private-key
